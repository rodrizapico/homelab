{
  "name": "Homelab DevContainer",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "runArgs": ["--env-file", ".devcontainer/.env.local"],
  "containerEnv": {
    "GIT_EDITOR": "nano",
    "TENV_AUTO_INSTALL": "true"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true
    },
    // TODO: we have this pinned to v1.2 due to this issue: https://github.com/devcontainers/features/issues/1505
    // Once it's resolved, we should switch back to the latest version
    "ghcr.io/devcontainers/features/nix:1.2": {
      "packages": "tenv,npins",
      "extraNixConfig": "experimental-features = nix-command flakes"
    },
    "ghcr.io/stuartleeks/dev-container-features/shell-history:0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "bierner.github-markdown-preview",
        "tomasdahlqvist.markdown-admonitions",
        "opentofu.vscode-opentofu",
        "redhat.vscode-yaml",
        "bbenoist.nix",
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "postCreateCommand": "/workspace/.devcontainer/post-create.sh"
}
